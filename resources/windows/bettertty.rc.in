#include <windows.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/windows/bettertty.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DD-LAB\0"
            VALUE "FileDescription", "BetterTTY SSH & SFTP Client\0"
            VALUE "FileVersion", "@BETTERTTY_VERSION_STRING@\0"
            VALUE "InternalName", "BetterTTY\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Dalibor Klobučarić\0"
            VALUE "OriginalFilename", "BetterTTY.exe\0"
            VALUE "ProductName", "BetterTTY\0"
            VALUE "ProductVersion", "@BETTERTTY_VERSION_STRING@\0"
            VALUE "Comments", "A better way to SSH. Your servers. One dock.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
